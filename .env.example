# Copiar a .env (ignorado por git) y completar. En CI estos valores vienen de GitHub Secrets.

# Repos de la app (por defecto, carpetas hermanas de este repo)
BACK_DIR=../giracanchera-back
FRONT_DIR=../giracanchera-front

# Base de TEST (docker-compose.test.yml). Los scripts se niegan a correr si no es localhost y una base *_test
TEST_DATABASE_URL=postgresql://qa:qa@localhost:5434/giracanchera_test

# Secreto de las sesiones para la API de test (mínimo 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Contraseñas de los usuarios de prueba que crea el seed (8+ caracteres, con letras y números)
QA_ADMIN_PASSWORD=
QA_USER_PASSWORD=
QA_USER2_PASSWORD=
